# Copy to .env.local (git-ignored) and fill in.

# Backend API base URL. Leave unset to use /api, which the Vite dev server
# proxies to the backend on port 8000. Set it when the backend is elsewhere,
# e.g. VITE_API_URL=https://api.example.com/api
# VITE_API_URL=

# Must match API_TOKEN in backend/.env when the backend requires a token.
VITE_API_TOKEN=
