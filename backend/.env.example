# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# API Keys Configuration
GROQ_API_KEY=your_groq_api_key_here
PARALLEL_API_KEY=your_parallel_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
WEATHER_API_KEY=your_openweather_api_key_here
STOCK_API_KEY=your_alphavantage_api_key_here
GOOGLE_API_KEY=google_api_key
TAVILY_API_KEY=tavily_api_key

# LangSmith tracing / online evaluation
# Off by default. true sends every prompt and document chunk to LangSmith.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=OpenGPT
LANGCHAIN_PROJECT=OpenGPT
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
# Older LangChain-style env name (optional, kept for compatibility)
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=chatbot_db

# Server
# HOST=127.0.0.1          # use 0.0.0.0 to expose the API on your network
# PORT=8000
# RELOAD=false            # true = auto-reload on code changes (development)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ENABLE_DOCS=true        # /docs; defaults to on locally, off when HOST is exposed
# LOG_LEVEL=INFO          # DEBUG also logs queries and thread ids

# Limits
# RATE_LIMIT_PER_MINUTE=20   # chat/upload/query requests per client per minute (0 = off)
# MAX_MESSAGE_CHARS=20000
# MAX_UPLOAD_MB=20
# MAX_BLOG_SECTIONS=10
# MAX_CACHED_RETRIEVERS=32

# Access control
# When set, every /api request must send "Authorization: Bearer <API_TOKEN>".
# Put the same value in frontend/.env.local as VITE_API_TOKEN=...
# Required when HOST is not 127.0.0.1 (the server refuses to start without it).
# API_TOKEN=
