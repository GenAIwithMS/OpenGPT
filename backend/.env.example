# =============================================================================
# Model provider (required)
# =============================================================================
# OpenGPT works with any endpoint that speaks the OpenAI or the Anthropic API.
#   LLM_PROVIDER=openai     OpenAI, or any OpenAI-compatible server
#   LLM_PROVIDER=anthropic  Anthropic, or any Anthropic-compatible server
# Set LLM_BASE_URL to the server's URL; leave it empty for OpenAI / Anthropic
# themselves. A self-hosted server may not need LLM_API_KEY.
# Use a model that supports tool calling.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional: different models per task (each defaults to LLM_MODEL)
# LLM_SMALL_MODEL=        # chat titles, search summaries
# BLOG_MODEL=             # blog writer
# RESEARCH_MODEL=         # deep research
# LLM_MAX_TOKENS=8192     # max output tokens per call

# =============================================================================
# Tool API keys (optional; each enables one feature)
# =============================================================================
# web search (preferred)
PARALLEL_API_KEY=
# web search fallback
BRAVE_API_KEY=
# OpenWeather
WEATHER_API_KEY=
# Alpha Vantage
STOCK_API_KEY=
# Gemini images in blogs (skipped when empty)
GOOGLE_API_KEY=
# deep research with SEARCH_API=tavily
TAVILY_API_KEY=

# =============================================================================
# MySQL database
# =============================================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=chatbot_db

# =============================================================================
# LangSmith tracing (off by default; true sends prompts and documents to LangSmith)
# =============================================================================
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=OpenGPT
LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# Server
# =============================================================================
# HOST=127.0.0.1          # use 0.0.0.0 to expose the API on your network
# PORT=8000
# RELOAD=false            # true = auto-reload on code changes (development)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ENABLE_DOCS=true        # /docs; defaults to on locally, off when HOST is exposed
# LOG_LEVEL=INFO          # DEBUG also logs queries and thread ids

# Limits
# RATE_LIMIT_PER_MINUTE=20   # chat/upload/query requests per client per minute (0 = off)
# MAX_MESSAGE_CHARS=20000
# MAX_UPLOAD_MB=20
# MAX_BLOG_SECTIONS=10
# MAX_CACHED_RETRIEVERS=32
# MAX_CHECKPOINTS_PER_THREAD=20   # older checkpoints are deleted (0 = keep all)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Deep research (optional overrides)
# SEARCH_API=parallel        # parallel | tavily | duckduckgo | none
# MAX_RESEARCHER_ITERATIONS=6
# MAX_REACT_TOOL_CALLS=10
# MAX_CONCURRENT_RESEARCH_UNITS=5

# Access control
# When set, every /api request must send "Authorization: Bearer <API_TOKEN>".
# Put the same value in frontend/.env.local as VITE_API_TOKEN=...
# Required when HOST is not 127.0.0.1 (the server refuses to start without it).
# API_TOKEN=
